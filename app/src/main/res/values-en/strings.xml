    <!-- Permissions -->
    <string name="perm_notification_title">Show compression progress?</string>
    <string name="perm_notification_body">A notification lets you follow and control long compressions, even when the app is in the background. No data leaves your device.</string>
    <string name="perm_storage_title">Allow saving files?</string>
    <string name="perm_storage_body">Your device needs storage access so compressed files can be saved to your gallery and files apps.</string>
    <string name="perm_rationale_notification">Notifications show the progress of long jobs and let you pause or cancel them from anywhere. Allow to keep going in the background?</string>

