    <!-- Onboarding -->
    <string name="onboard_title_0" formatted="false">100% Offline — 100% Private</string>
    <string name="onboard_body_0">No file is ever uploaded. All processing happens on your device. No internet, no account, no worry.</string>
    <string name="onboard_title_1">Photo Compression</string>
    <string name="onboard_body_1">Supports JPEG, PNG, WebP and HEIC. Colors and ICC profiles preserved. Keep or strip EXIF metadata as you choose.</string>
    <string name="onboard_title_2">Video Compression</string>
    <string name="onboard_body_2">Hardware-accelerated H.264 and H.265. Trim, resolution choice, audio management — all offline.</string>
    <string name="onboard_title_3">Audio Compression</string>
    <string name="onboard_body_3">Supports MP3, AAC, FLAC, OGG and WAV. ID3 tags and album art are preserved.</string>
    <string name="onboard_title_4">Smart Mode</string>
    <string name="onboard_body_4" formatted="false">Smart mode automatically finds the best quality-to-size balance — always keeping perceptual quality above 70%.</string>
