<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <!-- WAKELOCK: prevents Xiaomi/Huawei/OnePlus from killing the service mid-compression -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- BACKUP-FIX: allowBackup=false is the whole policy (no cloud copy of
     the history DB). The dataExtractionRules/fullBackupContent attributes
     were dead config — they are ignored while allowBackup is false, so they
     were removed to avoid implying a backup that never happens. -->
    <application
        android:name="com.compressly.CompresslyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Compressly"
        tools:targetApi="35">

        <activity
            android:name="com.compressly.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Compressly.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SHARE-TARGET: receive media shared from any app, compress it and
                 re-share. Classifies by MIME; all types are offline-processed. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name="com.compressly.core.service.CompressionJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
