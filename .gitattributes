# Normalise line endings to LF; treat these as text for clean diffs.
* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Binary assets keep as-is.
*.png binary
*.webp binary
*.ttf binary
*.jar binary
*.jks binary
